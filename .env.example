# Copy to .env.local for local development (never commit .env.local).

# Local database started by `pnpm db:dev` (or docker compose up db)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/bakery

# Absolute origin used for canonical URLs, sitemap and JSON-LD
SITE_URL=http://localhost:3000

# Used by `pnpm admin:create` (12+ characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-passphrase

# Only in AWS: CloudFront distribution to invalidate after recipe edits
# CLOUDFRONT_DISTRIBUTION_ID=
